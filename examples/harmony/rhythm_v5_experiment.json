{
  "version": "rhythm_v5_preregistered_comparison",
  "date": "2026-11-08",
  "scope": "数据扩充与可控节奏的有界实验；所有测试曲目只用于最终报告，不用于选参数或检查点。",
  "data_config": "examples/harmony/trusted_subset_v5.json",
