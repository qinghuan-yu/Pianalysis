  "duration_decode": "predict all onset masks first; duration candidates end at or before the next same-lane onset",
  "metrics": ["per_song_onset_precision_recall_F1", "raw_and_rendered_duration_MAE_on_matched_onsets", "onsets_per_quarter", "density_profile_order", "retrigger_cuts", "melody_frame_reversal_NLL"],
  "promotion": "Do not replace accepted V4 automatically; report regressions and request audition only after artifact checks."
