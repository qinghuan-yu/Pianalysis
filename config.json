{
  "project_name": "Pianalysis",
  "description": "Melody-conditioned symbolic piano accompaniment generation",
  "data": {
    "training_dataset": "data/training_windows_tsd_v2/dataset_windows_v1.json",
    "format": "[BOS] source_melody [SEP] target_accompaniment [EOS]",
    "tokenizer_version": "pianalysis_tsd_v2",
    "quantum_ms": 10,
    "window_seconds": 8,
    "max_length": 1024,
    "loss_rule": "Mask source tokens before target_start_index and mask padding with -100"
  },
  "token_ids": {
    "PAD": 0,
    "BOS": 1,
    "SEP": 2,
    "EOS": 3,
    "TIME": 4,
    "NOTE_ON_MELODY": 10,
    "NOTE_OFF_MELODY": 11,
    "NOTE_ON_ACCOMP": 20,
    "NOTE_OFF_ACCOMP": 21,
    "HARMONY": 30,
    "BAR": 31,
    "CHORD_NC": 32
  },
  "model": {
    "architecture": "GPT-2 causal LM",
    "n_positions": 1024,
    "n_embd": 512,
    "n_layer": 6,
    "n_head": 8,
    "dropout": 0.1
  },
  "training": {
    "output_dir": "model_output/accompaniment_gpt2_tsd_v2",
    "batch_size": 8,
    "eval_batch_size": 8,
    "epochs": 20,
    "learning_rate": 0.0005,
    "warmup_steps": 200,
    "save_steps": 250,
    "eval_steps": 250,
    "logging_steps": 25,
    "eval_ratio_by_piece": 0.1,
    "seed": 42,
    "early_stopping_patience": 3
  },
  "generation": {
    "script": "generate_from_scratch.py",
    "model_path": "model_output/accompaniment_gpt2_tsd_v2_e20/final_model",
    "max_new_tokens": 384,
    "temperature": 0.7,
    "top_k": 30,
    "top_p": 0.9,
    "grammar_constraints": true,
    "window_seconds": 8
  }
}
